+fn owned_listener() -> std::io::Result<UnixListener> {
+    let path = var_os("FRAMEY_SYNCTHING_SOCKET")
+        .map(PathBuf::from)
+        .ok_or_else(|| std::io::Error::other("Owned socket path is required"))?;
+    let listener = UnixListener::bind(&path)?;
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))?;
+    Ok(listener)
+}
+
+async fn serve_owned(listener: UnixListener, settings: Arc<SettingsProvider>) -> std::io::Result<()> {
+    loop {
+        let (stream, _) = listener.accept().await?;
+        let settings = settings.clone();
+        tokio::spawn(async move {
+            let service = service_fn(move |req| handle(Ipv4Addr::LOCALHOST.into(), req, settings.clone()));
+            if let Err(err) = hyper::server::conn::Http::new().serve_connection(stream, service).await {
+                warn!("Owned HTTP connection failed: {err}");
+            }
+        });
+    }
 }
 
