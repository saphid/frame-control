+// Linux PR_SET_PDEATHSIG binds this helper to the spawning plugin thread.
+// Decky's five-second SIGKILL fallback cannot run Python's _unload callback.
+// This is a lifetime guard for our child, not PID-file/name-based discovery.
+unsafe extern "C" {
+    fn prctl(option: std::ffi::c_int, ...) -> std::ffi::c_int;
+    fn getppid() -> std::ffi::c_int;
+}
+
+fn bind_owner_lifetime() -> std::io::Result<()> {
+    use std::io::{Error, ErrorKind};
+    let parent = match std::env::var("FRAMEY_SYNCTHING_OWNER_PID") {
+        Ok(value) => value.parse::<i32>()
+            .map_err(|_| Error::new(ErrorKind::InvalidInput, "Invalid owning plugin PID"))?,
+        Err(std::env::VarError::NotPresent) => unsafe { getppid() },
+        Err(error) => return Err(Error::new(ErrorKind::InvalidInput, error)),
+    };
+    if parent <= 1 {
+        return Err(Error::other("Owning plugin is unavailable"));
+    }
+    // PR_SET_PDEATHSIG=1, SIGKILL=9 are Linux ABI constants on both targets.
+    if unsafe { prctl(1, 9 as std::ffi::c_ulong, 0 as std::ffi::c_ulong,
+                     0 as std::ffi::c_ulong, 0 as std::ffi::c_ulong) } != 0 {
+        return Err(Error::last_os_error());
+    }
+    // The expected PID comes from Python before fork/exec: a subreaper must
+    // not become our apparent owner if the plugin died before this guard ran.
+    if unsafe { getppid() } != parent {
+        return Err(Error::other("Owning plugin exited before helper startup"));
+    }
+    Ok(())
+}
