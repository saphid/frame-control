+fn acquire_ownership(pid_file_path: &Path) -> Result<File, Box<dyn std::error::Error>> {
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(pid_file_path.with_extension("framey-lock"))?;
+    // A killed predecessor receives its parent-death signal asynchronously.
+    // Allow a bounded handoff, but never bypass another owner's lock.
+    let deadline = Instant::now() + Duration::from_millis(500);
+    loop {
+        match file.try_lock() {
+            Ok(()) => return Ok(file),
+            Err(std::fs::TryLockError::WouldBlock) if Instant::now() < deadline => {
+                std::thread::sleep(Duration::from_millis(25));
+            }
+            Err(error) => return Err(error.into()),
+        }
     }
 }
 
