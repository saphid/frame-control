+    svc_thread(0x1C, r);
+    assert(r[0] == 0 && atomic_load(&mutex_word) == t->handle);
+    r[0] = (uint64_t)&mutex_word; svc_thread(0x1B, r);
+    atomic_fetch_add(&fifo_done, 1);
+    thread_exit(t);
+    return NULL;
