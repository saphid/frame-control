new file mode 100644
index 0000000..f290c5a
--- /dev/null
+++ b/dm/android/app/frame_probe.h
@@ -0,0 +1,66 @@
+// Opt-in bring-up check, executed on the game's boot thread in its app domain.
+#pragma once
+#include <dlfcn.h>
+#include <sys/mman.h>
+#include <vulkan/vulkan.h>
+static void **frame_tp(void) { void **p; __asm__ volatile("mrs %0, tpidr_el0" : "=r"(p)); return p; }
+static _Atomic int frame_probe_failures;
+#define FRAME_CHECK(c) do { if (!(c)) { atomic_fetch_add(&frame_probe_failures, 1); fprintf(stderr, "frame-probe: FAIL %s\n", #c); } } while (0)
+static void *frame_probe_worker(void *arg) {
+    void **tp = frame_tp();
+    FRAME_CHECK(tp[2] == NULL);
+    if (tp[2]) return NULL;
+    uint64_t block[8] = {0}; block[3] = (uintptr_t)arg;
+    tp[2] = block;
+    for (int i = 0; i < 1000; ++i) { void *p = malloc(64 + i); free(p); char b[64]; snprintf(b, sizeof b, "%d %f", i, i * .5); }
+    void *h = dlopen("libvulkan.so", RTLD_NOW);
+    FRAME_CHECK(h != NULL);
+    if (h) { FRAME_CHECK(dlsym(h, "vkCreateInstance") != NULL); dlclose(h); }
+    VkApplicationInfo ai = {.sType=VK_STRUCTURE_TYPE_APPLICATION_INFO, .pApplicationName="Frame TLS check", .apiVersion=VK_API_VERSION_1_1};
+    VkInstanceCreateInfo ci = {.sType=VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo=&ai};
+    VkInstance instance = VK_NULL_HANDLE;
+    VkResult rc = vkCreateInstance(&ci, NULL, &instance);
+    FRAME_CHECK(rc == VK_SUCCESS);
+    if (rc == VK_SUCCESS) vkDestroyInstance(instance, NULL);
+    sched_yield();
+    FRAME_CHECK(tp[2] == block);
+    uint64_t value;
+    __asm__ volatile("mrs %0, tpidr_el0\n ldr %0, [%0, #16]\n ldr %0, [%0, #24]" : "=&r"(value));
+    FRAME_CHECK(value == (uintptr_t)arg);
+    tp[2] = NULL;
+    return NULL;
+}
+static int frame_probe(void) {
+    FRAME_CHECK(frame_tp()[2] == NULL);
+    pthread_t threads[16]; int started = 0;
+    for (int i = 0; i < 16; ++i) { int rc = pthread_create(&threads[started], NULL, frame_probe_worker, (void *)(uintptr_t)(0x1000 + i)); FRAME_CHECK(rc == 0); if (!rc) ++started; }
+    for (int i = 0; i < started; ++i) FRAME_CHECK(pthread_join(threads[i], NULL) == 0);
+    size_t page = (size_t)sysconf(_SC_PAGESIZE);
+    uint32_t *code = mmap(NULL, page, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    FRAME_CHECK(code != MAP_FAILED);
+    if (code != MAP_FAILED) {
+        code[0] = 0x52800540; code[1] = 0xd65f03c0; // mov w0, #42; ret
+        __builtin___clear_cache((char *)code, (char *)(code + 2));
+        int rc = mprotect(code, page, PROT_READ | PROT_EXEC); FRAME_CHECK(rc == 0);
+        if (!rc) FRAME_CHECK(((int (*)(void))code)() == 42);
+        munmap(code, page);
+    }
+    VkApplicationInfo ai = {.sType=VK_STRUCTURE_TYPE_APPLICATION_INFO, .pApplicationName="NxNative Frame probe", .apiVersion=VK_API_VERSION_1_1};
+    VkInstanceCreateInfo ci = {.sType=VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo=&ai};
+    VkInstance instance = VK_NULL_HANDLE;
+    VkResult rc = vkCreateInstance(&ci, NULL, &instance); FRAME_CHECK(rc == VK_SUCCESS);
+    if (rc == VK_SUCCESS) {
+        VkPhysicalDevice devices[8]; uint32_t n = 8;
+        rc = vkEnumeratePhysicalDevices(instance, &n, devices); FRAME_CHECK(rc == VK_SUCCESS && n > 0);
+        if (rc == VK_SUCCESS) for (uint32_t i = 0; i < n; ++i) {
+            VkPhysicalDeviceSubgroupProperties sg = {.sType=VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_PROPERTIES};
+            VkPhysicalDeviceProperties2 p = {.sType=VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,.pNext=&sg};
+            VkPhysicalDeviceFeatures f; vkGetPhysicalDeviceProperties2(devices[i], &p); vkGetPhysicalDeviceFeatures(devices[i], &f);
+            fprintf(stderr, "frame-probe: Vulkan device=%s api=%u.%u.%u driver=%u BC=%u float64=%u int64=%u subgroup=%u\n", p.properties.deviceName, VK_VERSION_MAJOR(p.properties.apiVersion), VK_VERSION_MINOR(p.properties.apiVersion), VK_VERSION_PATCH(p.properties.apiVersion), p.properties.driverVersion, f.textureCompressionBC, f.shaderFloat64, f.shaderInt64, sg.subgroupSize);
+        }
+        vkDestroyInstance(instance, NULL);
+    }
+    fprintf(stderr, "frame-probe: %s failures=%d threads=%d page=%zu\n", frame_probe_failures ? "FAIL" : "PASS", (int)frame_probe_failures, started, page);
+    return frame_probe_failures;
+}
+#undef FRAME_CHECK
