+    for (int e = 0; e < 2; e++) for (int i = 0; i < 2; i++) { uint64_t r[32] = {scope_ev[e][i]}; svc_thread(0x16, r); }
+    int ok = kind >= 2 ? payload == 1 : payload == 2 && done;
+    static const char *what[] = {"woken worker beside a busy unrelated peer", "worker woken by the woken dispatcher", "woken thread yielding to any thread",
+                                 "woken thread waiting for the signaller's host lock"};
+    printf("%s: handoff scope, %s: signaller returned, payload %d, worker exited %d\n", ok ? "PASS" : "FAIL", what[kind], payload, done);
+    return ok;
+}
+static void *already_runnable(void *arg) {
+    thr_t *t = arg; pthread_setspecific(g_keythr, t);
+    usleep(20000); atomic_store(&scope_payload, 1); thread_exit(t); return NULL;
+}
+static int profile_preempt(void) {
+    // No wake and no handoff ownership: a profile-enabled SVC must still wait
+    // for a higher-priority same-core worker already processing a queue entry.
+    thr_t *t = scope_new(&scope_peer[0], 30); pthread_t p;
+    atomic_store(&scope_payload, 0);
+    assert(!pthread_create(&p, NULL, already_runnable, t));
+    uint64_t r[32] = {0}; svc_thread(0x45, r);
+    int ok = atomic_load(&scope_payload) == 1;
+    pthread_join(p, NULL); scope_free(t);
+    printf("%s: profile preemption waits for an already-runnable worker\n", ok ? "PASS" : "FAIL");
+    return ok;
+}
+int main(int argc, char **argv) {
+    alarm(10);
+    setenv("DM_CORE_SERIAL", "0", 1);
+    setenv("DM_PREEMPT", argc > 1 ? "1" : "0", 1);
+    setenv("DM_YIELD_BACKOFF", "0", 1);
+    main_handle = svc_thread_main_init();
+    if (argc > 1) return profile_preempt() ? 0 : 1;
+    condition_order();
+    int ok = 1;
+    for (int kind = 0; kind <= 3; kind++) ok &= handoff_scope(kind);
+    for (int kind = 0; kind <= 4; kind++) if (kind != 3) {
+        ok &= delayed_wake(1000, kind, 0);
+        ok &= delayed_wake(20000, kind, 0);
+    }
+    for (int exclusion = 1; exclusion <= 7; exclusion++) {
+        ok &= delayed_wake(20000, 0, exclusion);
+        ok &= delayed_wake(20000, 4, exclusion);
+    }
+    return ok ? 0 : 1;
+}
