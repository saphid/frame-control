+#ifndef FRAME_VK_IMAGE_H
+#define FRAME_VK_IMAGE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+
+/* Values match VkImageViewType, without requiring Vulkan for parser tests. */
+enum { FVI_1D, FVI_2D, FVI_3D, FVI_CUBE, FVI_1D_ARRAY, FVI_2D_ARRAY, FVI_CUBE_ARRAY,
+       FVI_UNSUPPORTED = -2 };
+typedef struct { uint32_t set, binding; int view, ms, descriptor_array; } frame_vk_image_binding;
+typedef struct { uint32_t op, link, binding, set; uint8_t decorated, dim, arrayed, ms, storage; } frame_vk_image_node;
+
+/* Only image interface reflection, not a complete SPIR-V validator. Every
+ * instruction length and every ID followed here is checked. Work and memory
+ * are bounded independently of untrusted module header values. Direct Binding
+ * and DescriptorSet decorations are the translator's standard output. */
+static int frame_vk_image_reflect(const uint32_t *w, size_t nw,
+        frame_vk_image_binding *out, size_t capacity, size_t *count) {
+    if (!count) return 0;
+    *count = 0;
+    if (!w || nw < 5 || nw > 4194304 || w[0] != 0x07230203u || !w[3] ||
+            w[3] > 1048576 || w[4] || (!out && capacity)) return 0;
+    uint32_t bound = w[3];
+    frame_vk_image_node *nodes = calloc(bound, sizeof *nodes);
+    if (!nodes) return 0;
+    int good = 0;
+    for (size_t at = 5; at < nw;) {
+        uint32_t len = w[at] >> 16, op = w[at] & 65535, id = 0, link = 0;
+        if (!len || len > nw - at) goto done;
+        const uint32_t *p = w + at;
+        if (op >= 19 && op <= 33) {
+            if (len < 2) goto done;
+            id = p[1];
+            if (op == 25) {
+                if ((len != 9 && len != 10) || p[3] > 6 || p[4] > 2 || p[5] > 1 || p[6] > 1 || p[7] > 2) goto done;
+                if (!p[2] || p[2] >= bound) goto done;
+            } else if (op == 27 || op == 29) {
+                if (len != 3) goto done;
+                link = p[2];
+            } else if (op == 28) {
+                if (len != 4 || !p[3] || p[3] >= bound) goto done;
+                link = p[2];
+            } else if (op == 32) {
+                if (len != 4) goto done;
+                link = p[3];
+            }
+        } else if (op == 59) {
+            if (len != 4 && len != 5) goto done;
+            id = p[2]; link = p[1];
+        } else if (op == 71) {
+            if (len < 3 || !p[1] || p[1] >= bound) goto done;
+            if (p[2] == 33 || p[2] == 34) {
+                if (len != 4) goto done;
+                frame_vk_image_node *n = nodes + p[1];
+                unsigned flag = p[2] == 33 ? 1 : 2;
+                uint32_t *value = p[2] == 33 ? &n->binding : &n->set;
+                if ((n->decorated & flag) && *value != p[3]) goto done;
+                n->decorated |= flag; *value = p[3];
+            }
+        }
+        if (id) {
+            if (id >= bound || nodes[id].op || (link && link >= bound)) goto done;
+            frame_vk_image_node *n = nodes + id;
+            n->op = op; n->link = link;
+            if (op == 25) { n->dim = (uint8_t)p[3]; n->arrayed = (uint8_t)p[5]; n->ms = (uint8_t)p[6]; }
+            if (op == 59) n->storage = p[3] == 0 ? 1 : 0; /* UniformConstant */
+            if ((op == 27 || op == 28 || op == 29 || op == 32 || op == 59) && !link) goto done;
+        } else if ((op >= 19 && op <= 33) || op == 59) goto done;
+        at += len;
+    }
+    for (uint32_t id = 1; id < bound; id++) {
+        const frame_vk_image_node *n = nodes + id;
+        if (n->op != 59 || !n->storage || !(n->decorated & 1)) continue;
+        uint32_t next = n->link; unsigned depth = 0; int array = 0;
+        for (;;) {
+            if (!next || next >= bound || depth++ >= 32) goto done;
+            const frame_vk_image_node *t = nodes + next;
+            if (!t->op) goto done;
+            if (t->op == 32 || t->op == 27 || t->op == 28 || t->op == 29) {
+                if (t->op == 28 || t->op == 29) array = 1;
+                next = t->link; continue;
+            }
+            if (t->op == 25) {
+                int view = t->dim == 0 ? (t->arrayed ? FVI_1D_ARRAY : FVI_1D) :
+                           t->dim == 1 ? (t->arrayed ? FVI_2D_ARRAY : FVI_2D) :
+                           t->dim == 2 && !t->arrayed ? FVI_3D :
+                           t->dim == 3 ? (t->arrayed ? FVI_CUBE_ARRAY : FVI_CUBE) : FVI_UNSUPPORTED;
+                if (*count == capacity) goto done;
+                for (size_t k = 0; k < *count; k++) if (out[k].set == n->set && out[k].binding == n->binding) goto done;
+                out[(*count)++] = (frame_vk_image_binding){n->set, n->binding, view, t->ms, array};
+            }
+            break;
+        }
+    }
+    good = 1;
+done:
+    free(nodes);
+    if (!good) *count = 0;
+    return good;
+}
+
+/* Sampled views only: 2D <-> 2D-array is legal even for a single image layer.
+ * Cube views require the image's creation flag, square faces, complete groups
+ * of six layers and conservative six-aligned bases. 3D slice attachment views
+ * belong to the renderer's separate attachment path. No 1D/2D reinterpretation
+ * is possible without creating and filling a different image. */
+static int frame_vk_image_view_layers(int image_dim, int cube_compatible,
+        uint32_t width, uint32_t height, uint32_t layers, uint32_t first,
+        uint32_t available, int wanted, uint32_t *selected) {
+    if (!selected || !width || !height || !layers || first >= layers ||
+            !available || available > layers - first) return 0;
+    uint32_t count = available;
+    if (image_dim == 0) {
+        if (wanted != FVI_1D && wanted != FVI_1D_ARRAY) return 0;
+        if (wanted == FVI_1D) count = 1;
+    } else if (image_dim == 1) {
+        if (wanted == FVI_2D) count = 1;
+        else if (wanted == FVI_2D_ARRAY) {}
+        else if (wanted == FVI_CUBE || wanted == FVI_CUBE_ARRAY) {
+            if (!cube_compatible || width != height || first % 6 || available < 6) return 0;
+            count = wanted == FVI_CUBE ? 6 : available - available % 6;
+        } else return 0;
+    } else if (image_dim == 2) {
+        if (wanted != FVI_3D || first || layers != 1 || available != 1) return 0;
+    } else return 0;
+    *selected = count;
+    return 1;
+}
+#endif
diff --git a/dm/android/src_vk/frame_vk_readback.h b/dm/android/src_vk/frame_vk_readback.h
new file mode 100644
index 0000000..4ccf8d4
--- /dev/null
+++ b/dm/android/src_vk/frame_vk_readback.h
@@ -0,0 +1,93 @@
+#ifndef FRAME_VK_READBACK_H
+#define FRAME_VK_READBACK_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include "../tex/nvn_deswizzle.h"
+
+typedef struct { int x, y, z, w, h, d; } frame_vk_read_region;
+/* Values from the public NVN target/flag enums. Keep this helper usable without
+ * the complete graphics API header in portable storage tests. */
+enum { FVR_1D = 0, FVR_2D = 1, FVR_3D = 2, FVR_1D_ARRAY = 3,
+       FVR_MS = 5, FVR_MS_ARRAY = 6, FVR_BUFFER = 10,
+       FVR_LINEAR = 0x10, FVR_LINEAR_RT = 0x40 };
+typedef struct {
+    /* slices: available layers or volume slices; depth: requested slice count */
+    uint32_t width, height, slices, xbytes, yrows, rows, depth;
+    uint64_t bytes, row, image, span;
+} frame_vk_read_layout;
+static int frame_vk_read_layout_get(const nvn_texdesc *d, unsigned level,
+        unsigned layer0, frame_vk_read_region r, size_t row, size_t image,
+        uintptr_t dst, frame_vk_read_layout *out) {
+    int bw = 1, bh = 1, bpb = nvn_fmt_bpb(d->format, &bw, &bh);
+    if (!bpb || !dst || level >= 32 || level >= (d->levels ? d->levels : 1) ||
+        r.x < 0 || r.y < 0 || r.z < 0 || r.w <= 0 || r.h <= 0 || r.d < 0 ||
+        d->samples > 1 || d->target == FVR_MS || d->target == FVR_MS_ARRAY || d->target == FVR_BUFFER) return 0;
+    uint32_t w = d->width >> level, h = d->height >> level;
+    if (!w) w = 1;
+    if (d->target == FVR_1D || d->target == FVR_1D_ARRAY) h = 1;
+    else if (!h) h = 1;
+    /* Geometry helpers address a byte within a row with uint32_t. Reject a
+     * dimension whose block-byte conversion would truncate that coordinate. */
+    if (((uint64_t)w + bw - 1) / bw * bpb > UINT32_MAX) return 0;
+    nvn_texlayout tl; nvn_tex_layout(d, &tl);
+    uint32_t depth = d->target == FVR_3D ? d->depth >> level : tl.layers;
+    if (!depth) depth = 1;
+    uint32_t nz = r.d ? (uint32_t)r.d : 1;
+    uint64_t endx = (uint64_t)r.x + r.w, endy = (uint64_t)r.y + r.h;
+    uint64_t endz = (uint64_t)r.z + nz + (d->target == FVR_3D ? 0 : layer0);
+    if (endx > w || endy > h || endz > depth ||
+        (d->target == FVR_3D && layer0) || r.x % bw || r.y % bh ||
+        (r.w % bw && endx != w) || (r.h % bh && endy != h)) return 0;
+    uint64_t wb = ((uint64_t)r.w + bw - 1) / bw * bpb;
+    uint32_t hb = ((uint32_t)r.h + bh - 1) / bh;
+    uint64_t rr = row ? row : wb;
+    if (rr < wb || rr > SIZE_MAX / hb) return 0;
+    uint64_t ii = image ? image : rr * hb;
+    if (ii < rr * hb || (nz > 1 && ii > (SIZE_MAX - rr * (hb - 1) - wb) / (nz - 1))) return 0;
+    uint64_t span = ii * (nz - 1) + rr * (hb - 1) + wb;
+    if (span > UINTPTR_MAX - dst) return 0;
+    *out = (frame_vk_read_layout){w, h, depth, (uint32_t)(r.x / bw) * (uint32_t)bpb,
+        (uint32_t)(r.y / bh), hb, nz, wb, rr, ii, span};
+    return 1;
+}
+/* Read only requested blocks, without allocating/deswizzling a whole atlas.
+ * Padding between destination rows and images remains untouched. */
+static int frame_vk_read_storage(const nvn_texdesc *d, const uint8_t *mem,
+        uint64_t size, unsigned level, unsigned layer0, frame_vk_read_region r,
+        uint8_t *dst, size_t row, size_t image) {
+    frame_vk_read_layout q;
+    if (!mem || !frame_vk_read_layout_get(d, level, layer0, r, row, image, (uintptr_t)dst, &q)) return 0;
+    int linear = (d->flags & (FVR_LINEAR | FVR_LINEAR_RT)) != 0;
+    if (linear && (d->target != FVR_2D || level || q.depth != 1)) return 0;
+    int bw = 1, bh = 1, bpb = nvn_fmt_bpb(d->format, &bw, &bh);
+    uint64_t pitch = 0;
+    if (linear) {
+        uint64_t fullrow = ((uint64_t)q.width + bw - 1) / bw * bpb;
+        uint64_t align = d->flags & FVR_LINEAR_RT ? 128 : 32;
+        pitch = d->stride ? d->stride : (fullrow + align - 1) / align * align;
+        if (pitch < fullrow) return 0;
+    }
+    /* Validate all source offsets before changing any destination bytes. */
+    for (int copy = 0; copy < 2; copy++) for (uint32_t z = 0; z < q.depth; z++) {
+        uint32_t rb = 0, rows = 0, slices = 0, bp = 0; uint64_t base = 0; unsigned th = 0, td = 0;
+        unsigned layer = d->target == FVR_3D ? 0 : layer0 + (unsigned)r.z + z;
+        if (!linear && nvn_deswizzle_geom(d, level, layer, &rb, &rows, &slices, &base, &th, &td, &bp)) return 0;
+        uint32_t lb = linear ? 0 : nvn_tex_level_gobs(d, level) * 64;
+        if (lb < rb) lb = rb;
+        for (uint32_t y = 0; y < q.rows; y++) for (uint64_t x = 0; x < q.bytes;) {
+            uint32_t bx = q.xbytes + (uint32_t)x;
+            uint64_t n = linear ? q.bytes : 16 - bx % 16;
+            if (n > q.bytes - x) n = q.bytes - x;
+            uint64_t off = linear ? ((uint64_t)q.yrows + y) * pitch + bx :
+                nvn_bl_offset(bx, q.yrows + y, d->target == FVR_3D ? (uint32_t)r.z + z : 0, lb, rows, th, td);
+            if (off > UINT64_MAX - base) return 0;
+            off += base;
+            if (off > size || n > size - off || off > UINTPTR_MAX - (uintptr_t)mem || n > UINTPTR_MAX - (uintptr_t)mem - off) return 0;
+            if (copy) memcpy(dst + z * q.image + y * q.row + x, mem + off, (size_t)n);
+            x += n;
+        }
+    }
+    return 1;
+}
+#endif
diff --git a/dm/android/src_vk/frame_vk_state.h b/dm/android/src_vk/frame_vk_state.h
new file mode 100644
index 0000000..f730bf4
--- /dev/null
+++ b/dm/android/src_vk/frame_vk_state.h
@@ -0,0 +1,32 @@
+// Small Vulkan replay semantics shared with the host-side regression tests.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+static uint32_t frame_vk_ubo_handle(uint64_t addr, uint64_t size, int off) {
+    if (!addr || off < 0 || size < 4 || (uint64_t)off > size - 4 ||
+        addr > UINTPTR_MAX - (uint64_t)off - 3) return 0;
+    uint32_t handle; memcpy(&handle, (const void *)(uintptr_t)(addr + off), 4); return handle;
+}
+// NVN's rectangles address the same memory rows in either window convention.
+// Lower-left changes clip Y; a NEGATIVE_Y swizzle changes it once more.
+static int frame_vk_viewport_y(int lower_left, uint32_t swizzle, float *y, float *height) {
+    if (lower_left) { *y += *height; *height = -*height; }
+    if (swizzle == 0x100) { *y += *height; *height = -*height; }
+    return !swizzle || swizzle == 0x100;
+}
+static void frame_vk_present_y(int lower_left, int32_t y, int32_t height, int32_t *first, int32_t *last) {
+    *first = lower_left ? y + height : y; *last = lower_left ? y : y + height;
+}
+// Rebasing a vertex upload must not change shader-visible VertexIndex/BaseVertex.
+static int frame_vk_preserve_vertex_index(const uint32_t *words, size_t count) {
+    for (size_t i = 5; i < count;) {
+        uint32_t len = words[i] >> 16, op = words[i] & 0xffff;
+        if (!len || len > count - i) break;
+        if (op == 71 && len >= 4 && words[i + 2] == 11 &&
+            (words[i + 3] == 42 || words[i + 3] == 4424)) return 1;
+        if (op == 72 && len >= 5 && words[i + 3] == 11 &&
+            (words[i + 4] == 42 || words[i + 4] == 4424)) return 1;
+        i += len;
+    }
+    return 0;
+}
diff --git a/dm/android/src_vk/frame_vk_vertex.h b/dm/android/src_vk/frame_vk_vertex.h
new file mode 100644
index 0000000..beeefff
--- /dev/null
+++ b/dm/android/src_vk/frame_vk_vertex.h
@@ -0,0 +1,115 @@
+#ifndef FRAME_VK_VERTEX_H
+#define FRAME_VK_VERTEX_H
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+
+/* Maxwell fetch converts the NVN format into 32-bit register values. Shader
+ * reflection can declare those registers as float, uint or int, independently
+ * of the format. Vulkan requires matching numeric classes at the interface. */
+typedef struct { int fmt, convert, size; } frame_vk_vertex_plan;
+typedef struct { int n, bits, kind; } frame_vk_vertex_desc;
+typedef struct { uint64_t from, bytes, count; } frame_vk_vertex_range;
+/* Validate before multiplying indices or adding guest addresses. Limit is the
+ * number of converted 16-byte elements the destination allocation can hold. */
+static int frame_vk_vertex_range_get(uint64_t first, uint64_t last,
+        uint64_t stride, uint64_t offset, uint64_t size, uint64_t addr,
+        uint64_t available, uint64_t limit, frame_vk_vertex_range *out) {
+    if (!size || !addr || addr > UINTPTR_MAX || first > last) return 0;
+    if (!stride) first = last = 0;
+    uint64_t span = last - first;
+    if (span == UINT64_MAX || span + 1 > limit) return 0;
+    if (offset > UINT64_MAX - size) return 0;
+    uint64_t tail = offset + size;
+    if (stride && last > (UINT64_MAX - tail) / stride) return 0;
+    uint64_t from = first * stride + offset, end = last * stride + tail;
+    if (end > available || end > UINTPTR_MAX - addr) return 0;
+    *out = (frame_vk_vertex_range){from, end - from, span + 1};
+    return 1;
+}
+enum { FVV_FLOAT, FVV_UINT, FVV_SINT, FVV_UNORM, FVV_SNORM, FVV_HALF,
+       FVV_USCALED, FVV_SSCALED, FVV_UFLOAT };
+static frame_vk_vertex_desc frame_vk_vertex_desc_get(int f) {
+    if (f >= 1 && f <= 0x30) {
+        static const int bits[12] = {8,8,8,8,16,16,16,16,16,32,32,32};
+        static const int kind[12] = {FVV_UNORM,FVV_SNORM,FVV_UINT,FVV_SINT,FVV_HALF,FVV_UNORM,FVV_SNORM,FVV_UINT,FVV_SINT,FVV_FLOAT,FVV_UINT,FVV_SINT};
+        int i=(f-1)%12; return (frame_vk_vertex_desc){(f-1)/12+1,bits[i],kind[i]};
+    }
+    if (f >= 0x51 && f <= 0x68) {
+        int i=(f-0x51)/2; return (frame_vk_vertex_desc){i/3+1,8<<(i%3),(f&1)?FVV_USCALED:FVV_SSCALED};
+    }
+    switch (f) {
+        case 0x3d: return (frame_vk_vertex_desc){4,10,FVV_UNORM};
+        case 0x3e: return (frame_vk_vertex_desc){4,10,FVV_UINT};
+        case 0x3f: return (frame_vk_vertex_desc){3,11,FVV_UFLOAT};
+        case 0x69: return (frame_vk_vertex_desc){4,10,FVV_SNORM};
+        case 0x6a: return (frame_vk_vertex_desc){4,10,FVV_SINT};
+        case 0x6b: return (frame_vk_vertex_desc){4,10,FVV_USCALED};
+        case 0x6c: return (frame_vk_vertex_desc){4,10,FVV_SSCALED};
+        case 0x9a: return (frame_vk_vertex_desc){4,8,FVV_UNORM};
+    }
+    return (frame_vk_vertex_desc){0,0,0};
+}
+static frame_vk_vertex_plan frame_vk_vertex_plan_get(int f,int ct) {
+    frame_vk_vertex_desc d=frame_vk_vertex_desc_get(f);
+    int integer=d.kind==FVV_UINT||d.kind==FVV_SINT;
+    int cls=integer?(d.kind==FVV_UINT?1:2):0;
+    int size=d.bits==10||d.kind==FVV_UFLOAT?4:d.n*d.bits/8;
+    frame_vk_vertex_plan p={f,0,size};
+    if (!d.n) return p;
+    /* 32-bit integer-to-float formats have no Vulkan scaled variant. */
+    if ((d.kind==FVV_USCALED||d.kind==FVV_SSCALED)&&d.bits==32) p.convert=1;
+    if (cls!=ct) {
+        /* Four-component 32-bit values can be reinterpreted at fetch without
+         * changing bits. Smaller vectors need converted default W as well. */
+        if ((integer||d.kind==FVV_FLOAT)&&d.bits==32&&(d.n==4||(cls&&ct))) p.fmt=(d.n-1)*12+0x0a+ct;
+        else p.convert=1;
+    }
+    if (p.convert) p.fmt=0x2e + ct; /* RGBA32F/UI/I */
+    return p;
+}
+static float frame_vk_vertex_small_float(uint32_t v,int mb) {
+    int e=(v>>mb)&31; uint32_t m=v&((1u<<mb)-1);
+    if (!e) return ldexpf((float)m,-14-mb);
+    if (e==31) return m?NAN:INFINITY;
+    return ldexpf(1.0f+(float)m/(float)(1u<<mb),e-15);
+}
+static float frame_vk_vertex_half(uint16_t h) {
+    uint32_t e=(h>>10)&31,m=h&1023; float f;
+    if (!e) f=ldexpf((float)m,-24);
+    else if(e==31) f=m?NAN:INFINITY;
+    else f=ldexpf(1.0f+(float)m/1024.0f,(int)e-15);
+    return h&0x8000?-f:f;
+}
+/* Output contains the original register bits, including NVN missing components.
+ * It is read through RGBA32F/UI/I according to the shader declaration. */
+static void frame_vk_vertex_convert(int f,const uint8_t *src,uint32_t out[4]) {
+    frame_vk_vertex_desc d=frame_vk_vertex_desc_get(f);
+    int integer=d.kind==FVV_UINT||d.kind==FVV_SINT;
+    out[0]=out[1]=out[2]=0; out[3]=integer?1:0x3f800000u;
+    uint32_t packed=0;
+    if (d.bits==10||d.kind==FVV_UFLOAT) memcpy(&packed,src,4);
+    for(int c=0;c<d.n;c++) {
+        int bits=d.bits; uint32_t u=0; float v=0;
+        if(d.kind==FVV_UFLOAT) { int mb=c==2?5:6; u=c==0?packed&2047:c==1?(packed>>11)&2047:packed>>22; v=frame_vk_vertex_small_float(u,mb); }
+        else {
+            if(bits==10) { bits=c==3?2:10; u=(packed>>(c*10))&((1u<<bits)-1); }
+            else if(bits==8) u=src[f==0x9a?(c==3?3:2-c):c];
+            else if(bits==16) { uint16_t h; memcpy(&h,src+2*c,2); u=h; }
+            else memcpy(&u,src+4*c,4);
+            int32_t s=bits==32?(int32_t)u:(int32_t)(u<<(32-bits))>>(32-bits);
+            switch(d.kind) {
+                case FVV_UINT: out[c]=u; continue;
+                case FVV_SINT: out[c]=(uint32_t)s; continue;
+                case FVV_FLOAT: out[c]=u; continue;
+                case FVV_HALF: v=frame_vk_vertex_half((uint16_t)u); break;
+                case FVV_UNORM: v=(float)u/(float)((1u<<bits)-1); break;
+                case FVV_SNORM: v=fmaxf((float)s/(float)((1u<<(bits-1))-1),-1.0f); break;
+                case FVV_USCALED: v=(float)u; break;
+                case FVV_SSCALED: v=(float)s; break;
+            }
+        }
+        memcpy(out+c,&v,4);
+    }
+}
+#endif
