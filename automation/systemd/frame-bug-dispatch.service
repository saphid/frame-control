[Unit]
Description=Frame Control private queue dispatcher (saphid/frame-control)

[Service]
Type=oneshot
WorkingDirectory=%h/Services/frame-control-intake
ExecStart=/usr/bin/python3 %h/Services/frame-control-intake/automation/bug_dispatch.py --config %h/.config/frame-control-intake/dispatch.json
UMask=0077
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/frame-control-intake
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
