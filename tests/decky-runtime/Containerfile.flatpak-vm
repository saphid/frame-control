# Guest rootfs for matching AMD64/ARM64 QEMU TCG; no host bus, devices or home.
FROM debian:trixie-slim
ARG KERNEL_PACKAGE=linux-image-amd64
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd-sysv dbus-user-session libpam-systemd ${KERNEL_PACKAGE} python3 python3-dbus python3-gi python3-websockets dbus-bin dbus-daemon \
      ca-certificates zlib1g openssl libbz2-1.0 liblzma5 liblz4-1 libzstd1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1100 -s /bin/sh tester \
    && mkdir -p /run/user/1100 && chown tester:tester /run/user/1100
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 XDG_RUNTIME_DIR=/run/user/1100
USER root
WORKDIR /repo
ENTRYPOINT ["/bin/true"]

RUN apt-get update && apt-get install -y --no-install-recommends flatpak ostree gir1.2-ostree-1.0 && rm -rf /var/lib/apt/lists/*
