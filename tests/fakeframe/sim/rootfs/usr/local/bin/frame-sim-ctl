#!/usr/bin/env python3
"""The Frame simulator's own switches, beside fakeframe-ctl's. Run as root
(scripts/frame-sim.sh ctl runs it with docker exec).

  vr on|off       SteamVR running: vrcmd, the headset view, /dev/video99
  worn on|off     someone wearing it: vrcmd activity level and the proximity sensor
  state           the simulator's state
"""
import json
import sys

sys.path.insert(0, '/usr/local/lib/fakeframe/sim')
import simstate as ss  # noqa: E402

ON_OFF = {'on': True, 'off': False}
args = sys.argv[1:]
if len(args) == 2 and args[0] in ('vr', 'worn') and args[1] in ON_OFF:
    with ss.update() as s:
        s[args[0]] = ON_OFF[args[1]]
    ss.apply()
    print(json.dumps({'ok': True, args[0]: ON_OFF[args[1]]}))
elif args == ['state']:
    print(json.dumps(ss.read(), indent=1))
else:
    sys.exit(__doc__.strip())
