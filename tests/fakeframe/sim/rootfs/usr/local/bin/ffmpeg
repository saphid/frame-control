#!/usr/bin/env python3
"""ffmpeg for the Frame simulator: the real one, with the headset's capture inputs
swapped for the simulated scene.

On the Frame, the live view and recordings read SteamVR's copy of the headset view
from a v4l2loopback device (/dev/video99) and the sound from PipeWire's pulse
server; a panel's own window comes from x11grab (ui/server.py stream_command,
ui/frame_clips.py). None of those exist in a container, so each of those inputs,
from its `-f` to its `-i`, becomes a lavfi source instead: the moving test scene
(scene.py) or a quiet tone. Every other ffmpeg use (clip export, remuxing) runs
unchanged.
"""
import os
import sys

sys.path.insert(0, '/usr/local/lib/fakeframe')
sys.path.insert(0, '/usr/local/lib/fakeframe/sim')
import fakeframe_state as fs  # noqa: E402
import scene  # noqa: E402
import simstate as ss  # noqa: E402

REAL = '/usr/bin/ffmpeg'
TONE = 'sine=frequency=220:sample_rate=48000,volume=0.05'


def rewrite(args):
    out, swapped, i = [], [], 0
    while i < len(args):
        if args[i] == '-f' and i + 1 < len(args) and args[i + 1] in ('v4l2', 'x11grab', 'pulse'):
            kind = args[i + 1]
            try:
                end = args.index('-i', i + 2)
            except ValueError:
                return args, []         # not an input after all; leave it to ffmpeg
            options, source = args[i + 2:end], args[end + 1] if end + 1 < len(args) else ''
            if kind == 'pulse':
                out += ['-f', 'lavfi', '-i', TONE]
            else:
                if kind == 'v4l2' and not ss.read()['vr']:
                    sys.exit(f'{source}: No such device')   # SteamVR stopped: its device went with it
                fps = options[options.index('-framerate') + 1] if '-framerate' in options else '30'
                scene.text()
                out += ['-re', '-f', 'lavfi', '-i', scene.graph(int(fps))]
            swapped.append({'kind': kind, 'source': source, 'options': options})
            i = end + 2
            continue
        out.append(args[i])
        i += 1
    return out, swapped


def main():
    args, swapped = rewrite(sys.argv[1:])
    if swapped:
        fs.log('ffmpeg', inputs=swapped)
    os.execv(REAL, [REAL] + args)


if __name__ == '__main__':
    main()
